# David AI backend environment template
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data

# Supabase: keep the secret key server-side only. Never place it in frontend code.
SUPABASE_URL=https://yvkylmxvikffkyhxqesh.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SECRET_KEY=<server-secret-key>
DATABASE_URL=<postgresql-connection-string>
SUPABASE_STORAGE_BUCKET=Davidai
SUPABASE_PERSISTENCE_ENABLED=false
SUPABASE_SIGNED_URL_TTL=3600
SUPABASE_REQUEST_TIMEOUT_SECONDS=20

# Existing provider configuration remains unchanged.
OPENAI_API_KEY=<provider-key>
GEMINI_API_KEY=<provider-key>
GROQ_API_KEY=<provider-key>
OPENROUTER_API_KEY=<provider-key>
CLOUDFLARE_API_KEY=<provider-key>
CLOUDFLARE_ACCOUNT_ID=<account-id>
CEREBRAS_API_KEY=<provider-key>
SAMBANOVA_API_KEY=<provider-key>
HUGGINGFACE_API_KEY=<provider-key>
OWNER_EMAIL=<owner-email>
OWNER_PASSWORD=<owner-password>

# GitHub App integration (server-side only - never expose in frontend code,
# docs, git history, or API responses). Create the GitHub App at
# https://github.com/settings/apps/new , install it on your own account, and
# populate these values in the Render environment.
GITHUB_APP_ID=<github-app-id>
GITHUB_APP_PRIVATE_KEY=<github-app-private-key>
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
GITHUB_INSTALLATION_ID=<github-app-installation-id>
PUBLIC_BASE_URL=https://david-ademola.onrender.com
