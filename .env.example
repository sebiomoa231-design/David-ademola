# David AI backend environment template
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data

# Supabase: keep the secret key server-side only. Never place it in frontend code.
SUPABASE_URL=https://yvkylmxvikffkyhxqesh.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SECRET_KEY=<server-secret-key>
DATABASE_URL=<postgresql-connection-string>
SUPABASE_STORAGE_BUCKET=Davidai
SUPABASE_PERSISTENCE_ENABLED=false
SUPABASE_SIGNED_URL_TTL=3600
SUPABASE_REQUEST_TIMEOUT_SECONDS=20

# Agent runtime guardrails. These limits apply to every dispatched run.
AGENT_MAX_GOAL_CHARS=12000
AGENT_MAX_STEPS=8
AGENT_MAX_RETRIES=1
AGENT_HISTORY_LIMIT=100
EXTERNAL_AGENT_TIMEOUT_SECONDS=30
# Allowlisted HTTPS agents; credentials are referenced by env name only.
# EXTERNAL_AGENTS_JSON=[{"id":"research-partner","label":"Research Partner","url":"https://agent.example.com/consult","protocol":"json_task","api_key_env":"RESEARCH_PARTNER_API_KEY","capabilities":["research","analysis"]}]

# Provider credentials are server-side only. Replace placeholders in Render
# or another secret manager; never commit real values or expose them to the UI.
OPENAI_API_KEY=<provider-key>
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.3-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
ANTHROPIC_API_KEY=<provider-key>
ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=<provider-key>
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GROQ_API_KEY=<provider-key>
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENROUTER_API_KEY=<provider-key>
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.3-chat
VOYAGE_API_KEY=<provider-key>
VOYAGE_API_BASE_URL=https://api.voyageai.com/v1
VOYAGE_MODEL=voyage-3.5
ELEVENLABS_API_KEY=<provider-key>
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_VOICE_ID=5hZv9mAOcmcMt1TxA5Iz
ELEVENLABS_VOICE_STYLE=British, deep male, JARVIS-style
# Speech Engine resource and public WebSocket endpoint; keep these server-side.
ELEVENLABS_SPEECH_ENGINE_ID=<speech-engine-id>
ELEVENLABS_SPEECH_ENGINE_PUBLIC_WS_URL=wss://<public-host>/api/voice/speech-engine/ws
ELEVENLABS_SPEECH_ENGINE_NAME=David AI Speech Engine
RUNWAY_API_KEY=<provider-key>
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com/v1
RUNWAY_MODEL=<verified-model-id>
LUMA_API_KEY=<provider-key>
LUMA_API_BASE_URL=https://api.lumalabs.ai/dream-machine/v1
LUMA_MODEL=<verified-model-id>
V0_API_KEY=<provider-key>
V0_API_BASE_URL=https://api.v0.dev
V0_MODEL=<verified-model-id>
GOOGLE_MAPS_API_KEY=<maps-demo-key>
RENDER_API_KEY=<server-api-key>
RENDER_API_BASE_URL=https://api.render.com/v1
RENDER_OWNER_ID=<workspace-id>
CLOUDFLARE_API_KEY=<provider-key>
CLOUDFLARE_ACCOUNT_ID=<account-id>
CEREBRAS_API_KEY=<provider-key>
SAMBANOVA_API_KEY=<provider-key>
HUGGINGFACE_API_KEY=<provider-key>
OWNER_EMAIL=<owner-email>
OWNER_PASSWORD=<owner-password>

# GitHub App integration (server-side only - never expose in frontend code,
# docs, git history, or API responses). Create the GitHub App at
# https://github.com/settings/apps/new , install it on your own account, and
# populate these values in the Render environment.
GITHUB_APP_ID=<github-app-id>
GITHUB_APP_PRIVATE_KEY=<github-app-private-key>
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
GITHUB_INSTALLATION_ID=<github-app-installation-id>
PUBLIC_BASE_URL=https://david-ademola.onrender.com
