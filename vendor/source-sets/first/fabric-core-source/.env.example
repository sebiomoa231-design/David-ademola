APP_NAME=David AI Intelligence Fabric
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/david_fabric.sqlite3
CORS_ORIGINS=http://localhost:3000

# Provider credentials remain outside source control.
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
HUGGINGFACE_API_KEY=

# Optional internal service URLs. Leave blank when a capability is not deployed.
BROWSER_USE_URL=
PLAYWRIGHT_URL=
OPENHANDS_URL=
COMFYUI_URL=
WAN2GP_URL=
CHATTERBOX_URL=
FASTER_WHISPER_URL=
LANGFUSE_URL=
N8N_URL=
TEMPORAL_URL=
COOLIFY_URL=
DOKPLOY_URL=

# Default routing policy
ALLOW_EXTERNAL_SIDE_EFFECTS=false
REQUIRE_APPROVAL_FOR_DEPLOYMENT=true
REQUIRE_APPROVAL_FOR_PUBLISH=true
REQUIRE_APPROVAL_FOR_DELETE=true
REQUIRE_APPROVAL_FOR_PURCHASE=true
